{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/app", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/join", "destination": "/join.html" }
  ]
}
